      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(host_updates_last_run_timestamp_seconds, hostname)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".*",
        "label": "Host",
        "name": "hostname",
        "options": [],
        "refresh": 2,
        "sort": 1,
        "type": "query",
        "query": {
          "qryType": 1,
          "query": "label_values(host_updates_last_run_timestamp_seconds, hostname)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        }
      },
      {
        "type": "custom",
        "name": "owner",
        "label": "Owner",
        "query": "hosting,ours",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": "$__all"
          },
          {
            "selected": false,
            "text": "hosting",
            "value": "hosting"
          },
          {
            "selected": false,
            "text": "ours",
            "value": "ours"
          }
        ]
      }
    ]
