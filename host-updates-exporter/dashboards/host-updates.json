        "h": 14,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "host_updates_package_pending_since_timestamp_seconds{owner=~\"$owner\",hostname=~\"$hostname\"} * 1000",
          "refId": "since",
          "legendFormat": "__auto",
          "format": "table",
          "instant": true,
          "range": false,
          "exemplar": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "(time() - host_updates_package_pending_since_timestamp_seconds{owner=~\"$owner\",hostname=~\"$hostname\"}) / 86400",
          "refId": "days",
