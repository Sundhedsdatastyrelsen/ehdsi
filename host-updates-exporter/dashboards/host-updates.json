    {
      "type": "stat",
      "title": "Hosts with security updates pending > 14 days",
      "description": "Same threshold as the 'Security updates pending' alert.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "count((time() - min by (hostname) (host_updates_package_pending_since_timestamp_seconds{security=\"true\",hostname=~\"$hostname\"})) > 14*86400) OR on() vector(0)",
          "refId": "A",
          "legendFormat": "__auto",
          "format": "table",
          "instant": true,
          "range": false,
          "exemplar": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true
      },
      "id": 2
    },
