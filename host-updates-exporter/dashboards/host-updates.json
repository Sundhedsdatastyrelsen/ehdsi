          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "count(host_updates_reboot_required{hostname=~\"$hostname\"} == 1) OR on() vector(0)",
          "refId": "A",
          "legendFormat": "__auto",
          "format": "table",
