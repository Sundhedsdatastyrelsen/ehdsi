##############################################################################
#  OpenNCP tomcat SSL connector properties                                   #
##############################################################################
CONNECTOR_PORT=${NCP_B_SERVER_CONNECTOR_PORT}
CONNECTOR_SECURE_PORT=${NCP_B_SERVER_CONNECTOR_SECURE_PORT}
KEY_ALIAS=${TLS_KEY_ALIAS}
# DK: The client connector is only called by national clients (e.g. the ePrescription portal), so it gets its own
# certificate, issued to the hostnames they connect to. Falls back to the EU TLS keystore when unset.
KEYSTORE_PATH=${CLIENT_CONNECTOR_TLS_KEYSTORE_PATH:-${TLS_KEYSTORE_PATH}}
TRUSTSTORE_PATH=${TLS_TRUSTSTORE_PATH}
CLIENT_AUTH=false
